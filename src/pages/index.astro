---
import "../styles/styles.css";
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Bump Dungeon</title>
    <meta
      name="description"
      content="A tiny bump-combat dungeon room: explore, fight what's in the way, level up, find the door."
    />

    <!--
      The link-preview card: public/card.png, 1200x630 --- replace it. The URL
      resolves against this page, like any link. No og:title/og:description:
      scrapers fall back to the <title> and description above.
    -->
    <meta property="og:type" content="website" />
    <meta property="og:image" content="./card.png" />
    <meta name="twitter:card" content="summary_large_image" />


  </head>
  <body>
    <header>
      <nav aria-label="Primary">
        <a href="./">Home</a>
      </nav>
    </header>
    <main>
      <h1>Bump Dungeon</h1>
      <div id="stage" role="application" aria-label="dungeon grid"></div>
      <div id="hp-bar" role="status" aria-live="polite"></div>
      <div id="level-bar" role="status" aria-live="polite"></div>
      <p id="log" role="status" aria-live="polite"></p>
      <div id="end" hidden>
        <p id="end-message"></p>
        <button id="restart-btn" type="button">Play again</button>
      </div>
    </main>
    <script src="../scripts/main.ts"></script>
  </body>
</html>
